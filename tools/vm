#!/bin/sh
# Drive the lima test VM from the host.
#   up     create/start the VM and install build deps (idempotent)
#   push   copy the working tree to ~/wavedevice in the guest
#   build  push, then build with W=1 and sparse (C=1); any warning fails
#   test   push, then run the userspace generator tests
#   smoke  build, then run tests/smoke.sh as root
#   devtest build, then run tests/devtest.sh (device behavior) as root
#   dkms   push, then install via DKMS, modprobe, read, uninstall
#   check  test + smoke + devtest + dkms
#   shell  interactive shell in the guest's copy
# No host mounts: the sandbox blocks virtiofs, and builds stay out of
# the host tree this way.
set -eu
VM=${VM:-wavedevice}
CPUS=${CPUS:-2}
MEM=${MEM:-2}
here=$(cd "$(dirname "$0")/.." && pwd)

guest() { limactl shell --workdir / "$VM" -- "$@"; }

up() {
	limactl list -q | grep -qx "$VM" ||
		limactl create --name="$VM" --tty=false --cpus="$CPUS" --memory="$MEM" \
			--mount-none template:debian-13
	limactl list --format '{{.Status}}' "$VM" | grep -qx Running ||
		limactl start "$VM"
	guest sh -c 'dpkg -s linux-headers-$(uname -r) sparse python3-numpy >/dev/null 2>&1 ||
		{ sudo DEBIAN_FRONTEND=noninteractive apt-get -qq update &&
		  sudo DEBIAN_FRONTEND=noninteractive apt-get -qq install -y \
			build-essential linux-headers-$(uname -r) sparse python3-numpy; }'
}

push() {
	COPYFILE_DISABLE=1 tar -C "$here" --no-xattrs --exclude ./.git \
		--exclude ./build -cf - . |
		guest sh -c 'rm -rf ~/wavedevice && mkdir ~/wavedevice &&
			tar -C ~/wavedevice --warning=no-unknown-keyword -xf -'
}

build() {
	push
	# Kbuild and sparse warnings don't fail the build; make them.
	guest bash -c 'set -o pipefail
		make -C ~/wavedevice W=1 C=1 2>&1 | tee ~/wavedevice/build.log
		! grep -n "warning:" ~/wavedevice/build.log ||
			{ echo "build: warnings are errors here" >&2; exit 1; }'
}

unit() {
	push
	guest sh -c 'make -C ~/wavedevice test'
}

smoke() {
	build
	guest sh -c 'cd ~/wavedevice && sudo timeout -k 10 300 sh tests/smoke.sh'
}

devtest() {
	build
	# Built as the guest user so root never owns files push must delete.
	guest sh -c 'make -C ~/wavedevice build/wgref &&
		cd ~/wavedevice && sudo timeout -k 10 300 sh tests/devtest.sh'
}

dkms() {
	push
	guest sh -c 'set -eu
		dpkg -s dkms >/dev/null 2>&1 ||
			sudo DEBIAN_FRONTEND=noninteractive apt-get -qq install -y dkms
		cd ~/wavedevice
		v=$(sed -n "s/^PACKAGE_VERSION=\"\(.*\)\"/\1/p" dkms.conf)
		sudo dkms remove wavedevice/$v --all >/dev/null 2>&1 || true
		sudo make -s dkms-install >/dev/null
		sudo dkms status wavedevice | grep -q installed
		sudo modprobe wavedevice
		sudo udevadm settle -t 10
		[ "$(cat /sys/module/wavedevice/version)" = "$v" ]
		[ "$(head -c 48000 /dev/sine | wc -c)" = 48000 ]
		sudo modprobe -r wavedevice
		sudo make -s dkms-uninstall >/dev/null
		! modinfo wavedevice >/dev/null 2>&1
		[ ! -e /usr/src/wavedevice-$v ]
		echo "dkms: ok ($v installed, loaded, read, removed)"'
}

check() { unit; smoke; devtest; dkms; }

shell() { limactl shell --workdir / "$VM" -- sh -c 'cd ~/wavedevice && exec bash -l'; }

case ${1-} in
up|push|build|smoke|devtest|dkms|check|shell) "$1" ;;
test) unit ;;
*) echo "usage: $0 {up|push|build|test|smoke|devtest|dkms|check|shell}" >&2; exit 2 ;;
esac
